rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check valid string
    function isNonEmptyString(val) {
      return val is string && val.size() > 0;
    }

    // Default catch-all rule
    match /{document=**} {
      allow read, write: if true;
    }

    // Master Barang
    match /barang/{barangId} {
      allow read: if true;
      allow write: if true;
    }

    // Stock Movements
    match /stockMovements/{movementId} {
      allow read: if true;
      allow write: if true;
    }

    // Opname Sessions
    match /opnameSessions/{sessionId} {
      allow read: if true;
      allow write: if true;
    }

    // Penerima Manfaat Collections
    match /beneficiaryGroups/{groupId} {
      allow read: if true;
      allow write: if true;
    }

    match /beneficiaryLocations/{locId} {
      allow read: if true;
      allow write: if true;
    }

    match /dailyBeneficiaryRecords/{recId} {
      allow read: if true;
      allow write: if true;
    }

    match /beneficiaryAuditLogs/{auditId} {
      allow read: if true;
      allow write: if true;
    }

    match /beneficiaryLocks/{lockId} {
      allow read: if true;
      allow write: if true;
    }

    // Tugas Divisi
    match /tugasDivisi/{tugasId} {
      allow read: if true;
      allow write: if true;
    }

    match /whatsappDivisiSettings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Nutrition & Bahan Pangan
    match /masterBahanPangan/{bahanId} {
      allow read: if true;
      allow write: if true;
    }

    match /masterMenuResep/{resepId} {
      allow read: if true;
      allow write: if true;
    }

    match /nutritionPlans/{planId} {
      allow read: if true;
      allow write: if true;
    }

    match /nutritionPlanItems/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // RAB Plans
    match /rabPlans/{rabId} {
      allow read: if true;
      allow write: if true;
    }

    // Purchase Orders & Suppliers
    match /purchaseOrders/{poId} {
      allow read: if true;
      allow write: if true;
    }

    match /suppliers/{supplierId} {
      allow read: if true;
      allow write: if true;
    }

    // Kedatangan Barang
    match /barangDatang/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // e-Surat
    match /suratMasuk/{suratId} {
      allow read: if true;
      allow write: if true;
    }

    match /suratKeluar/{suratId} {
      allow read: if true;
      allow write: if true;
    }

    match /disposisi/{dispId} {
      allow read: if true;
      allow write: if true;
    }

    // BBM & Kendaraan
    match /kendaraan/{kendaraanId} {
      allow read: if true;
      allow write: if true;
    }

    match /laporanBbm/{bbmId} {
      allow read: if true;
      allow write: if true;
    }

    // Master Organization & Pegawai
    match /pegawai/{pegawaiId} {
      allow read: if true;
      allow write: if true;
    }

    match /divisi/{divisiId} {
      allow read: if true;
      allow write: if true;
    }

    match /jabatan/{jabatanId} {
      allow read: if true;
      allow write: if true;
    }

    match /gudang/{gudangId} {
      allow read: if true;
      allow write: if true;
    }

    match /kategori/{kategoriId} {
      allow read: if true;
      allow write: if true;
    }

    match /instansi/{instansiId} {
      allow read: if true;
      allow write: if true;
    }

    // Users, Roles, Settings, Activity Logs, Notifications
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /roles/{roleId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /activityLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    match /notifications/{notifId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
